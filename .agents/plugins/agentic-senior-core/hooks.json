{
  "agentic-senior-core": {
    "PreToolUse": [
      {
        "matcher": "edit_file|write_file|replace_file_content|multi_replace_file_content|write_to_file|run_command",
        "hooks": [
          {
            "type": "command",
            "command": "node hooks/pre-tool-dependency-gate.js",
            "timeout": 5
          }
        ]
      }
    ],
    "PreInvocation": [
      {
        "type": "command",
        "command": "node hooks/ladder-pulse.js",
        "timeout": 5
      }
    ],
    "PostInvocation": [
      {
        "type": "command",
        "command": "node hooks/post-edit-enforce.js",
        "timeout": 15
      }
    ],
    "Stop": [
      {
        "type": "command",
        "command": "node hooks/stop-verify-gate.js",
        "timeout": 5
      }
    ]
  }
}
